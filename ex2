import heapq

class PriorityQueue:
    def __init__(self):
        self._queue = []
        self._index = 0

    def enqueue(self, item, priority):
        heapq.heappush(self._queue, (-priority, self._index, item))
        self._index += 1

    def dequeue(self):
        if not self._queue:
            return "Черга порожня"
        
        return heapq.heappop(self._queue)[-1]

pq = PriorityQueue()

pq.enqueue("task1", 2)
pq.enqueue("task2", 1)

print(pq.dequeue())  # Output: "task1"
print(pq.dequeue())  # Output: "task2"
